# Server settings for Planszowkarz. server-setup.sh copies this to /opt/planszowkarz/planszowkarz.env
# (chmod 600) on the first run and fills in the port. Fill in the CHANGE_ME values on the server, never here.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://[::]:__PORT__
ConnectionStrings__DefaultConnection=DataSource=/opt/planszowkarz/data/app.db;Cache=Shared
TZ=Europe/Warsaw
DOTNET_gcServer=0

# First admin, created on startup if it doesn't exist yet. The password can be removed after the first start.
Admin__UserName=planszowkarz.szczecinski@gmail.com
Admin__Email=planszowkarz.szczecinski@gmail.com
Admin__Password=CHANGE_ME

# Outgoing e-mail (Gmail: app password, not the account password). Leave Email__Host empty to disable.
Email__Host=smtp.gmail.com
Email__Port=587
Email__UserName=planszowkarz.szczecinski@gmail.com
Email__Password=CHANGE_ME
Email__FromAddress=planszowkarz.szczecinski@gmail.com

# BoardGameGeek API token (Claude_Resources/BGGToken.txt).
Bgg__Token=CHANGE_ME
