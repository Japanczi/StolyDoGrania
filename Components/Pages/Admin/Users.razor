@page "/admin/users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = AppRoles.Admin)]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Planszowkarz.Data
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db

<PageTitle>Użytkownicy</PageTitle>
<h1>Zarządzanie użytkownikami</h1>
<p><a href="admin/logs">Dziennik działań</a> – dołączenia do stołów, zmiany ról i usunięcia kont.</p>

@if (status is not null)
{
    <div class="alert alert-success alert-dismissible">
        @status
        <button type="button" class="btn-close" @onclick="() => status = null"></button>
    </div>
}
@if (error is not null)
{
    <div class="alert alert-danger alert-dismissible">
        @error
        <button type="button" class="btn-close" @onclick="() => error = null"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Dodaj użytkownika</h5>
        <EditForm Model="newUser" OnValidSubmit="AddUserAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label" for="nu-name">Nazwa użytkownika</label>
                    <InputText id="nu-name" class="form-control" @bind-Value="newUser.UserName" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="nu-email">E-mail</label>
                    <InputText id="nu-email" class="form-control" @bind-Value="newUser.Email" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="nu-pass">Hasło</label>
                    <InputText id="nu-pass" type="password" class="form-control" @bind-Value="newUser.Password" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="nu-role">Rola</label>
                    <InputSelect id="nu-role" class="form-select" @bind-Value="newUser.Role">
                        @foreach (var r in AppRoles.Assignable)
                        {
                            <option value="@r">@r</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">Dodaj</button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@if (rows is null)
{
    <p><em>Ładowanie...</em></p>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Nazwa użytkownika</th><th>E-mail</th><th style="width:180px">Rola</th><th style="width:220px"></th></tr></thead>
        <tbody>
            @foreach (var u in rows)
            {
                var isSelf = u.Id == currentUserId;
                // Mirrors the checks in ChangeRoleAsync / DeleteUserAsync, which are what actually enforce them.
                var protectedRow = !isSelf && !CanManage(u.Role);
                <tr>
                    <td>@u.UserName @if (isSelf) {
                        <span class="badge text-bg-secondary">to Ty</span>
                    }
                </td>
                <td>@u.Email</td>
                <td>
                    @if (u.Role == AppRoles.Owner)
                    {
                        <span class="badge text-bg-warning" title="Główny administrator">@AppRoles.Owner</span>
                    }
                    else
                    {
                        <select class="form-select form-select-sm" disabled="@(isSelf || protectedRow)"
                                title="@(protectedRow ? ProtectedAdminHint : null)"
                                value="@u.Role" @onchange="e => ChangeRoleAsync(u.Id, e.Value?.ToString())">
                            @foreach (var r in AppRoles.Assignable)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    }
                </td>
                <td class="text-end">
                    @if (!isSelf && !protectedRow)
                    {
                        @if (confirmDeleteId == u.Id)
                        {
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteUserAsync(u.Id)">Potwierdź usunięcie</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmDeleteId = null">Anuluj</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmDeleteId = u.Id">Usuń</button>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
}

@code {
    private record UserRow(string Id, string UserName, string Email, string Role);

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private const string ProtectedAdminHint = "Tylko główny administrator (Owner) może odebrać rolę administratora lub usunąć jego konto.";

    private List<UserRow>? rows;
    private string? currentUserId, status, error, confirmDeleteId;
    // For the UI only; every action re-checks it against the database.
    private bool currentIsOwner;
    private NewUserModel newUser = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
            currentUserId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var users = await UserManager.Users.AsNoTracking().OrderBy(u => u.Email).ToListAsync();
        var list = new List<UserRow>();
        foreach (var u in users)
        {
            list.Add(new UserRow(u.Id, u.UserName ?? "—", u.Email ?? "—", MainRole(await UserManager.GetRolesAsync(u))));
        }
        rows = list;
        currentIsOwner = list.Any(r => r.Id == currentUserId && r.Role == AppRoles.Owner);
    }

    /// <summary>The highest of a user's roles: Owner, then Admin, otherwise User.</summary>
    private static string MainRole(IList<string> roles) =>
        roles.Contains(AppRoles.Owner) ? AppRoles.Owner
        : roles.Contains(AppRoles.Admin) ? AppRoles.Admin
        : AppRoles.User;

    /// <summary>
    /// Whether the current user may change the role of, or delete, a user with this role:
    /// nobody touches the Owner, and only the Owner touches other admins.
    /// </summary>
    private bool CanManage(string targetRole) => CanManage(targetRole, currentIsOwner);

    private static bool CanManage(string targetRole, bool actorIsOwner) =>
        targetRole switch
        {
            AppRoles.Owner => false,
            AppRoles.Admin => actorIsOwner,
            _ => true
        };

    /// <summary>The current user, freshly from the database, and whether they are the Owner right now.</summary>
    private async Task<(ApplicationUser? Actor, bool IsOwner)> LoadActorAsync()
    {
        var actor = currentUserId is null ? null : await UserManager.FindByIdAsync(currentUserId);
        return (actor, actor is not null && await UserManager.IsInRoleAsync(actor, AppRoles.Owner));
    }

    /// <summary>Saves a log entry; a failure is shown but doesn't undo the action that was logged.</summary>
    private async Task WriteLogAsync(UserActionLog entry)
    {
        try
        {
            Db.UserActionLogs.Add(entry);
            await Db.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            Db.ChangeTracker.Clear();
            error = "Zmiana została zapisana, ale nie udało się zapisać wpisu w dzienniku.";
        }
    }

    private async Task AddUserAsync()
    {
        status = error = null;
        if (!AppRoles.Assignable.Contains(newUser.Role)) { error = "Nieprawidłowa rola."; return; }
        var userName = ValidUserNameAttribute.Normalize(newUser.UserName);
        var user = new ApplicationUser { UserName = userName, Email = newUser.Email.Trim(), EmailConfirmed = true };
        var result = await UserManager.CreateAsync(user, newUser.Password);
        if (!result.Succeeded)
        {
            error = string.Join(" ", result.Errors.Select(IdentityErrorText.Describe));
            return;
        }
        await UserManager.AddToRoleAsync(user, newUser.Role);
        status = $"Dodano użytkownika {userName}.";
        newUser = new();
        await LoadAsync();
    }

    private async Task ChangeRoleAsync(string id, string? newRole)
    {
        status = error = null;
        if (newRole is null || !AppRoles.Assignable.Contains(newRole) || id == currentUserId) return;

        var user = await UserManager.FindByIdAsync(id);
        if (user is null) { error = "Nie znaleziono użytkownika."; await LoadAsync(); return; }

        var current = await UserManager.GetRolesAsync(user);
        var oldRole = MainRole(current);
        var (actor, actorIsOwner) = await LoadActorAsync();
        if (actor is null || !CanManage(oldRole, actorIsOwner))
        {
            error = oldRole == AppRoles.Owner
                ? "Nie można zmienić roli głównego administratora."
                : ProtectedAdminHint;
            await LoadAsync();
            return;
        }
        if (oldRole == newRole) return;

        if (current.Count > 0) await UserManager.RemoveFromRolesAsync(user, current);
        var result = await UserManager.AddToRoleAsync(user, newRole);
        if (!result.Succeeded)
            error = string.Join(" ", result.Errors.Select(e => e.Description));
        else
        {
            await UserManager.UpdateSecurityStampAsync(user); // forces a fresh sign-in with the new role
            status = $"Zmieniono rolę użytkownika {user.UserName} na {newRole}.";
            await WriteLogAsync(UserActionLog.RoleChanged(actor.Id, actor.UserName, user, oldRole, newRole));
        }
        await LoadAsync();
    }

    private async Task DeleteUserAsync(string id)
    {
        status = error = null;
        confirmDeleteId = null;
        if (id == currentUserId) { error = "Nie możesz usunąć własnego konta."; return; }

        var user = await UserManager.FindByIdAsync(id);
        if (user is null) { error = "Nie znaleziono użytkownika."; return; }

        var role = MainRole(await UserManager.GetRolesAsync(user));
        var (actor, actorIsOwner) = await LoadActorAsync();
        if (actor is null || !CanManage(role, actorIsOwner))
        {
            error = role == AppRoles.Owner ? "Nie można usunąć konta głównego administratora." : ProtectedAdminHint;
            await LoadAsync();
            return;
        }

        // TableSlots.UserId nie jest kluczem obcym – zwalniamy miejsca usuwanego użytkownika
        await Db.TableSlots.Where(s => s.UserId == id).ExecuteDeleteAsync();

        var result = await UserManager.DeleteAsync(user);
        if (result.Succeeded)
        {
            status = $"Usunięto użytkownika {user.UserName}.";
            await WriteLogAsync(UserActionLog.UserRemoved(actor.Id, actor.UserName, user, role));
        }
        else
        {
            error = string.Join(" ", result.Errors.Select(e => e.Description));
        }
        await LoadAsync();
    }

    private sealed class NewUserModel
    {
        [Required(ErrorMessage = "Podaj nazwę użytkownika."), ValidUserName] public string UserName { get; set; } = "";
        [Required(ErrorMessage = "Podaj adres e-mail."), ValidEmail] public string Email { get; set => field = value.Trim(); } = "";
        [Required, StringLength(100, MinimumLength = 6)] public string Password { get; set; } = "";
        public string Role { get; set; } = AppRoles.User;
    }
}