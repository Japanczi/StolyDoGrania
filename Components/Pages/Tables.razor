@page "/"
@page "/stoly"
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using Planszowkarz.Data
@using Planszowkarz.Data.Bgg
@using Planszowkarz.Data.Table
@using static Planszowkarz.Components.Pages.GameDisplay
@inject ApplicationDbContext Db
@inject BggClient Bgg
@inject IOptions<TableSettings> Settings
@inject NormalUserMode Mode
@inject NavigationManager Nav
@inject BoardResetter Resetter
@inject FeedbackArchive Feedback
@inject DiskUsage Disk
@inject IJSRuntime JS

<PageTitle>Zapisy na gry</PageTitle>

<div class="toolbar">
    <h1>Zapisy na gry</h1>
    @if (!isLoggedIn)
    {
        <a class="btn btn-outline-light btn-sm" href="Account/Login?ReturnUrl=stoly">Zaloguj się, aby tworzyć stoły i zajmować miejsca</a>
    }
    @if (canSwitchMode)
    {
        <div class="form-check form-switch ms-auto mb-0">
            <input id="normal-user-mode" type="checkbox" class="form-check-input" checked="@normalModeActive" @onchange="SetNormalUserMode" />
            <label class="form-check-label" for="normal-user-mode">Tryb zwykłego użytkownika</label>
        </div>
    }
</div>

@if (statusMessage is not null)
{
    <div class="alert alert-success alert-dismissible py-2" role="alert">
        @statusMessage
        <button type="button" class="btn-close py-2" aria-label="Zamknij" @onclick="() => statusMessage = null"></button>
    </div>
}

@if (errorMessage is not null)
{
    <div class="alert alert-warning alert-dismissible py-2" role="alert">
        @errorMessage
        <button type="button" class="btn-close py-2" aria-label="Zamknij" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (tables is null)
{
    <p><em>Ładowanie...</em></p>
}
else if (tables.Count == 0 && !isLoggedIn)
{
    <div class="alert alert-info py-2">Nie ma jeszcze żadnych stołów.</div>
}
else
{
    <div class="table-list">
        <div class="table-row table-head">
            <div class="cell"></div>
            <div class="cell cell-game">Gra</div>
            <div class="cell">Zajęte</div>
            <div class="cell">Stół</div>
            <div class="cell">Godzina</div>
            <div class="cell">Graczy</div>
            <div class="cell">BGG</div>
            <div class="cell">Trudność</div>
            <div class="cell">Okładka</div>
            <div class="cell cell-slots">Miejsca</div>
        </div>

        @foreach (var t in tables)
        {
            var isOwner = t.IsOwner(userId);
            var hasSeat = t.Participants.Any(p => p.UserId == userId);
            var canManage = isOwner || isAdmin;

            <div class="table-row @(t.Id == highlightTableId ? "table-new" : null)" @key="t.Id" @ref="rowRefs[t.Id]"
                 tabindex="@(t.Id == highlightTableId ? "-1" : null)">
                <div class="cell cell-actions">
                    <div class="actions">
                        @if (canManage)
                        {
                            <div class="action-anchor">
                                @* Two clicks: ❌ arms it (✅), the second click deletes. *@
                                <ConfirmDeleteButton ItemName="@t.DisplayTitle" Title="Usuń stół" ArmedTitle="Kliknij ponownie, aby usunąć stół"
                                                     Disabled="@busy" OnConfirm="() => DeleteTableAsync(t.Id)" />
                            </div>

                            <div class="action-anchor">
                                <button type="button" class="action-button action-rename" title="Zmień grę" aria-label="Zmień grę: @t.DisplayTitle"
                                        @onclick="() => OpenRename(t)">🏷️</button>
                                @if (renameTableId == t.Id)
                                {
                                    <div class="popup-backdrop" @onclick="CloseRename"></div>

                                    @* Any action button's popup goes in an .action-anchor like this, right after its button. *@
                                    <div class="action-popup action-popup-wide" role="dialog" aria-label="Zmień grę" @onkeydown="OnRenameKeyDown">
                                        <label for="rename-name">Nazwa gry</label>
                                        <input @ref="renameInput" id="rename-name" class="form-control form-control-sm" list="catalog-names" maxlength="200" autocomplete="off"
                                               @bind="renameName" @bind:after="OnGameNameChangedAsync" />

                                        @LookupMessages

                                        @if (RenameReady && RenamedMaxPlayers != t.MaxPlayers)
                                        {
                                            <span class="form-text mt-0">Liczba miejsc: @t.MaxPlayers → @RenamedMaxPlayers</span>
                                        }

                                        @if (t.TakenSlots > 0 || t.Participants.Any(p => !(p.SlotNumber == PlayTable.OwnerSlot && t.IsOwner(p.UserId))))
                                        {
                                            <span class="rename-warning">Zapisanie zwolni wszystkie miejsca (zostaje tylko właściciel).</span>
                                        }

                                        <div class="action-popup-buttons">
                                            <button type="button" class="btn btn-success btn-sm" disabled="@(busy || bggBusy)" @onclick="RenameTableAsync">Zapisz</button>
                                            @if (Bgg.IsConfigured)
                                            {
                                                <button type="button" class="btn btn-outline-light btn-sm" title="Szukaj tej gry na BoardGameGeek, np. innego wydania"
                                                        disabled="@bggBusy" @onclick="SearchBggManuallyAsync">BGG</button>
                                            }
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseRename">Anuluj</button>
                                        </div>
                                    </div>
                                }
                            </div>

                            @* Placeholders for owner options coming later in development. *@
                            @for (var i = 0; i < 3; i++)
                            {
                                <button type="button" class="action-button action-placeholder" disabled title="Opcja dostępna wkrótce" aria-label="Opcja dostępna wkrótce">🛠️</button>
                            }
                        }
                    </div>
                </div>

                <div class="cell cell-game">
                    <span class="game-name">@t.DisplayTitle</span>
                </div>

                <div class="cell">
                    @if (canManage)
                    {
                        <input @key="takenInputVersion" type="number" class="cell-input" min="0" max="@t.MaxTakenSlots"
                               value="@t.TakenSlots" aria-label="Liczba miejsc oznaczonych jako zajęte: @t.DisplayTitle"
                               @onchange="e => SetTakenSlotsAsync(t.Id, e.Value?.ToString())" />
                    }
                    else if (t.TakenSlots > 0)
                    {
                        @t.TakenSlots
                    }
                </div>

                <div class="cell @KindClass(t.Kind)">
                    @if (canManage)
                    {
                        <select class="cell-input" value="@t.Kind" aria-label="Rodzaj stołu: @t.DisplayTitle"
                                @onchange="e => SetKindAsync(t.Id, e.Value?.ToString())">
                            <option value="@TableKind.Small">@KindLabel(TableKind.Small)</option>
                            <option value="@TableKind.Big">@KindLabel(TableKind.Big)</option>
                            <option value="@TableKind.Other">@KindLabel(TableKind.Other)</option>
                        </select>
                    }
                    else
                    {
                        @KindLabel(t.Kind)
                    }
                </div>

                <div class="cell @(t.HasStartTime ? "" : "hour-unset")" title="@(t.HasStartTime ? null : "Godzina nie została ustalona")">
                    @if (canManage)
                    {
                        <HourPicker Value="@(t.HasStartTime ? TimeOnly.FromDateTime(t.Start) : null)"
                                    ValueChanged="hour => SetHourAsync(t.Id, hour)"
                                    AriaLabel="@($"Godzina spotkania: {t.DisplayTitle}")" />
                    }
                    else
                    {
                        @(t.HasStartTime ? t.Start.ToString("HH:mm") : "—")
                    }
                </div>

                <div class="cell">@t.MaxPlayers</div>

                <div class="cell">
                    <a href="@(t.Game.BggUrl ?? DefaultBggUrl)" target="_blank" rel="noopener noreferrer">Link</a>
                </div>

                <div class="cell cell-difficulty" style="@DifficultyStyle(t.Game.Difficulty)">
                    @DifficultyLabel(t.Game.Difficulty)
                </div>

                <div class="cell cell-cover">
                    @if (CoverSrc(t.Game) is { } src)
                    {
                        <img class="thumb" src="@src" alt="Okładka: @t.DisplayTitle" />
                    }
                    else
                    {
                        <div class="thumb thumb-placeholder" style="background-color:hsl(@PlaceholderHue(t.DisplayTitle), 55%, 35%);" aria-hidden="true">
                            @t.DisplayTitle
                        </div>
                    }
                </div>

                <div class="cell cell-slots">
                    @foreach (var n in Enumerable.Range(1, t.MaxPlayers))
                    {
                        var occupant = t.Participants.FirstOrDefault(p => p.SlotNumber == n);
                        var canAddPlayer = canManage && n != PlayTable.OwnerSlot && occupant is null;
                        var canAssignOwner = isAdmin && n == PlayTable.OwnerSlot && !t.IsSlotTaken(n);
                        var canOpenPopup = canAddPlayer || canAssignOwner;
                        var popupHint = canAssignOwner ? AssignOwnerHint : AddPlayerHint;

                        @if (t.IsSlotTaken(n))
                        {
                            <div class="slot slot-blocked" title="@(canAddPlayer ? AddPlayerHint : "Miejsce zajęte przez właściciela stołu")"
                                 @oncontextmenu="e => canAddPlayer ? OpenAddPlayerAsync(t, n, e) : Task.CompletedTask"
                                 @oncontextmenu:preventDefault="canAddPlayer">Zajęte</div>
                        }
                        else if (occupant is null)
                        {
                            var canTake = isLoggedIn && !hasSeat && (!isOwner || n == PlayTable.OwnerSlot);

                            @* Stays enabled when it can't be taken but has a popup: browsers don't report right-clicks on disabled buttons. *@
                            <button type="button" class="slot slot-free @(canTake ? "" : "slot-inert")"
                                    disabled="@(!canTake && !canOpenPopup)" aria-disabled="@(canTake ? "false" : "true")"
                                    title="@(canOpenPopup ? $"{FreeSlotHint(t, n, hasSeat)}. {popupHint}" : FreeSlotHint(t, n, hasSeat))"
                                    @onclick="() => canTake ? TakeSlotAsync(t.Id, n) : Task.CompletedTask"
                                    @oncontextmenu="e => canOpenPopup ? OpenAddPlayerAsync(t, n, e) : Task.CompletedTask"
                                    @oncontextmenu:preventDefault="canOpenPopup">
                                Wolne
                            </button>
                        }
                        else
                        {
                            var canFree = isLoggedIn && (occupant.UserId == userId || canManage);
                            var slotTitle = canFree ? $"Zwolnij miejsce: {occupant.ParticipantName}" : occupant.ParticipantName;

                            <button type="button" class="slot @(t.IsOwner(occupant.UserId) ? "slot-owner" : "slot-taken")"
                                    disabled="@(!canFree)" title="@(canAssignOwner ? $"{slotTitle}. {AssignOwnerHint}" : slotTitle)"
                                    @onclick="() => FreeSlotAsync(t.Id, n)"
                                    @oncontextmenu="e => canAssignOwner ? OpenAddPlayerAsync(t, n, e) : Task.CompletedTask"
                                    @oncontextmenu:preventDefault="canAssignOwner">
                                <span class="slot-name">@occupant.ParticipantName</span>
                            </button>
                        }
                    }
                </div>
            </div>
        }

        @if (isLoggedIn)
        {
            @* Only the name until it's looked up, then the rest of a table's columns. Not a <form>: Enter must not create a table. *@
            <div class="table-row table-draft">
                <div class="cell"></div>

                <div class="cell cell-game">
                    <input id="new-name" class="form-control form-control-sm" list="catalog-names" maxlength="200" autocomplete="off"
                           placeholder="Nazwa gry" aria-label="Nazwa gry nowego stołu"
                           @bind="newTable.GameName" @bind:after="OnGameNameChangedAsync" />
                    <datalist id="catalog-names">
                        @foreach (var catalogName in catalogNames)
                        {
                            <option value="@catalogName"></option>
                        }
                    </datalist>
                    <div class="draft-actions">
                        <button type="button" class="btn btn-success btn-sm" disabled="@(busy || bggBusy)" @onclick="CreateTableAsync">Utwórz stół</button>
                        @if (!string.IsNullOrWhiteSpace(newTable.GameName))
                        {
                            @if (Bgg.IsConfigured)
                            {
                                <button type="button" class="btn btn-outline-light btn-sm" title="Szukaj tej gry na BoardGameGeek, np. innego wydania"
                                        disabled="@bggBusy" @onclick="SearchBggManuallyAsync">BGG</button>
                            }
                            <button type="button" class="btn btn-outline-light btn-sm" @onclick="ResetDraft">Anuluj</button>
                        }
                    </div>
                    @if (recentPhrases.Count > 0)
                    {
                        @* The last names used to create tables (all users); a click fills the field and looks the game up. *@
                        <div class="recent-phrases" role="group" aria-label="Ostatnio używane nazwy gier">
                            <span class="recent-label">Ostatnio:</span>
                            @foreach (var phrase in recentPhrases)
                            {
                                <button type="button" class="recent-phrase" title="Użyj nazwy: @phrase" disabled="@(busy || bggBusy)"
                                        @onclick="() => UseRecentPhraseAsync(phrase)">@phrase</button>
                            }
                        </div>
                    }
                </div>

                @if (DraftDetailsVisible)
                {
                    var draftCover = selectedCoverSrc ?? CoverSrc(newCover, newCoverType);

                    <div class="cell">
                        <input id="new-taken" type="number" class="cell-input" min="0" max="@newTable.MaxPlayers"
                               aria-label="Liczba miejsc oznaczonych jako zajęte" @bind="newTable.TakenSlots" />
                    </div>

                    <div class="cell @KindClass(newTable.Kind)">
                        <select id="new-kind" class="cell-input" aria-label="Rodzaj stołu" @bind="newTable.Kind">
                            <option value="@TableKind.Small">@KindLabel(TableKind.Small)</option>
                            <option value="@TableKind.Big">@KindLabel(TableKind.Big)</option>
                            <option value="@TableKind.Other">@KindLabel(TableKind.Other)</option>
                        </select>
                    </div>

                    <div class="cell @(newTable.Hour is null ? "hour-unset" : "")">
                        <HourPicker @bind-Value="newTable.Hour" AriaLabel="Godzina spotkania" />
                    </div>

                    <div id="new-max" class="cell" title="@(selectedGame?.BggId is not null ? "Liczba graczy z BGG" : "Liczba wylosowana (1–6)")">@newTable.MaxPlayers</div>

                    <div class="cell">
                        @if (selectedGame?.BggId is { } draftBggId)
                        {
                            <a href="https://boardgamegeek.com/boardgame/@draftBggId" target="_blank" rel="noopener noreferrer">Link</a>
                        }
                        else
                        {
                            <span>–</span>
                        }
                    </div>

                    @* Difficulty comes only from BGG; users can't enter it. *@
                    <div id="new-difficulty" class="cell cell-difficulty" style="@DifficultyStyle(selectedGame?.Difficulty ?? 0)">@DifficultyLabel(selectedGame?.Difficulty ?? 0)</div>

                    <div class="cell cell-cover">
                        <div class="draft-cover">
                            @if (draftCover is not null)
                            {
                                <img class="thumb" src="@draftCover" alt="Okładka: @newTable.GameName" />
                            }
                            else
                            {
                                <div class="thumb thumb-placeholder" style="background-color:hsl(@PlaceholderHue(newTable.GameName), 55%, 35%);" aria-hidden="true">
                                    @newTable.GameName
                                </div>
                            }

                            @if (CanUploadDraftCover)
                            {
                                <label class="cover-upload" title="Dodaj okładkę (PNG, JPEG, WebP lub GIF, maks. 2 MB)">
                                    <span aria-hidden="true">🗁</span>
                                    <InputFile id="new-cover" OnChange="OnCoverSelected" class="visually-hidden" aria-label="Dodaj okładkę"
                                               accept="image/png,image/jpeg,image/webp,image/gif" />
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>

            @* While a table is being renamed, its popup shows the lookup instead. *@
            @if (!Renaming && (bggBusy || bggNote is not null || candidates is not null || formError is not null || (DraftDetailsVisible && selectedGame?.BggId is not null)))
            {
                <div class="draft-panel">
                    @LookupMessages
                </div>
            }
        }
    </div>
}

@if (addTarget is not null)
{
    <div class="popup-backdrop" @onclick="CloseAddPlayer" @oncontextmenu="CloseAddPlayer" @oncontextmenu:preventDefault></div>

    @* min() keeps the popup on screen wherever the right-click happened. *@
    var assigningOwner = addTarget.Slot == PlayTable.OwnerSlot;

    <div class="add-player" role="dialog" aria-label="@(assigningOwner ? "Wybierz właściciela stołu" : "Dodaj gracza")" @onkeydown="OnAddPlayerKeyDown"
         style="left:min(@(addTarget.X)px, calc(100vw - 270px));top:min(@(addTarget.Y)px, calc(100vh - 330px));">
        <strong class="add-player-title">@(assigningOwner ? "Wybierz właściciela stołu" : "Dodaj gracza")</strong>

        <div class="add-player-list">
            @foreach (var option in playerOptions)
            {
                <button type="button" class="add-player-option" disabled="@busy" @onclick="() => AddPlayerAsync(option.DisplayName, option.UserId)">
                    @option.DisplayName
                </button>
            }
            @if (playerOptions.Count == 0)
            {
                <span class="add-player-empty">Brak dostępnych graczy.</span>
            }
        </div>

        @* An owner needs an account, so a free-text name only works for regular seats. *@
        @if (!assigningOwner)
        {
            <form class="add-player-free" @onsubmit="() => AddPlayerAsync(freeTextName, null)">
                <input @ref="freeTextInput" class="form-control form-control-sm" maxlength="100" placeholder="Inne imię i nazwisko" aria-label="Inne imię i nazwisko"
                       @bind="freeTextName" @bind:event="oninput" />
                <button type="submit" class="btn btn-primary btn-sm" disabled="@(busy || string.IsNullOrWhiteSpace(freeTextName))">Dodaj</button>
            </form>
        }
    </div>
}

@if (isAdmin)
{
    @* Side by side in one dock, so an opened panel pushes its neighbour aside instead of covering it. *@
    <div class="admin-dock">
        <AdminHelpBox />
        <AdminToolbox TableCount="@(tables?.Count ?? 0)" AutoReset="@autoReset" Busy="@busy"
                      OnClearTables="ClearTablesAsync" OnAutoResetChanged="SetAutoResetAsync"
                      FeedbackCount="@feedbackCount" OnDownloadFeedback="DownloadFeedbackAsync"
                      DiskUsage="@diskUsage" OnShowDiskUsage="ShowDiskUsageAsync" />
    </div>
}

@code {
    private const string AddPlayerHint = "Prawy przycisk: dodaj gracza";
    private const string AssignOwnerHint = "Prawy przycisk: wybierz właściciela";
    private const int MaxListedCandidates = 20;
    private static readonly Uri DefaultBggUrl = new("https://boardgamegeek.com/");

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Id of a table just created on another page; it is focused and highlighted.</summary>
    [SupplyParameterFromQuery(Name = "nowy")] private int? NewTableId { get; set; }

    private int? highlightTableId;
    private readonly Dictionary<int, ElementReference> rowRefs = new();

    private List<PlayTable>? tables;
    private List<CatalogEntry> catalog = [];
    private List<string> catalogNames = [];

    private const int RecentPhraseCount = 5;

    /// <summary>The newest distinct names used to create tables (all users), newest first.</summary>
    private List<string> recentPhrases = [];

    private bool isLoggedIn;
    private bool isAdmin;
    private bool normalModeActive;
    private bool canSwitchMode;
    private string? userId;
    private string? displayName;

    private bool busy;
    private bool autoReset;
    private int feedbackCount;
    private DiskUsage.Report? diskUsage;
    private string? statusMessage;
    private string? errorMessage;
    private string? formError;

    private NewTableModel newTable = new();
    private byte[]? newCover;
    private string? newCoverType;

    // Game lookup in the new table form.
    private int drawnMaxPlayers;
    private bool bggBusy;
    private string? bggNote;
    private List<GameCandidate>? candidates;
    private string? candidatesTitle;
    private CatalogEntry? selectedGame;
    private string? selectedCoverSrc;
    // Bumped by each lookup, so that a reply to an outdated one (BGG can take seconds) is ignored.
    private int lookupVersion;

    // Renaming a table: the game lookup above serves this popup instead of the new table form.
    private int? renameTableId;
    private string renameName = string.Empty;
    private ElementReference renameInput;
    private bool focusRenameInput;

    // Add-player popup (owner's right-click on a slot).
    private AddPlayerTarget? addTarget;
    private List<PlayerOption> playerOptions = [];
    private string freeTextName = string.Empty;
    private ElementReference freeTextInput;
    private bool focusFreeText;

    // Changing this recreates the inputs, restoring the stored value after a rejected edit.
    private int takenInputVersion;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            isLoggedIn = user.Identity?.IsAuthenticated == true;
            if (isLoggedIn)
            {
                isAdmin = user.IsInRole(AppRoles.Admin);
                userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
                displayName = ShortName(user.Identity?.Name);
                // In normal user mode the role is hidden, so being in the mode is what keeps the way back available.
                normalModeActive = userId is not null && Mode.IsActive(userId);
                canSwitchMode = isAdmin || normalModeActive;
            }
        }

        ResetDraft();
        await LoadAsync();

        // Arrived from "Baza gier" right after creating a table there.
        if (NewTableId is { } newId && tables?.FirstOrDefault(t => t.Id == newId) is { } created)
        {
            highlightTableId = newId;
            statusMessage = $"Utworzono stół: {created.DisplayTitle}.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Runs once the circuit is up (not during prerendering); focusing the row scrolls it into view.
        if (firstRender && highlightTableId is { } id && rowRefs.TryGetValue(id, out var row))
        {
            await row.FocusAsync();
            // Drop the parameter, so a refresh doesn't announce the table again.
            Nav.NavigateTo("", replace: true);
        }

        if (focusFreeText)
        {
            focusFreeText = false;
            // The owner-assignment popup has no free-text field.
            if (addTarget?.Slot != PlayTable.OwnerSlot)
            {
                await freeTextInput.FocusAsync();
            }
        }

        if (focusRenameInput)
        {
            focusRenameInput = false;
            await renameInput.FocusAsync();
        }
    }

    private void SetNormalUserMode(ChangeEventArgs e)
    {
        if (!canSwitchMode || userId is null)
        {
            return;
        }

        Mode.Set(userId, e.Value is true);
        // Roles are read when a page connects, so a full reload applies the change.
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    // A full e-mail address is never displayed.
    private static string ShortName(string? name)
    {
        name ??= string.Empty;
        var at = name.IndexOf('@');
        return at > 0 ? name[..at] : name;
    }

    private async Task LoadAsync()
    {
        tables = await Db.PlayTables
            .AsNoTracking()
            .Include(t => t.Game)
            .Include(t => t.Participants)
            .OrderBy(t => t.Id)
            .ToListAsync();

        catalog = await Db.Games
            .AsNoTracking()
            .OrderBy(g => g.Name)
            .Select(g => new CatalogEntry(
                g.Id, g.Name, g.Kind, g.Difficulty, g.MaxPlayers, g.BggId, g.YearPublished,
                g.Cover != null && g.CoverContentType != "image/svg+xml",
                g.AlternateNames.Select(a => a.Name).ToList()))
            .ToListAsync();

        catalogNames = catalog
            .SelectMany(g => g.AlternateNames.Prepend(g.Name))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Order(StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        // Only the draft row shows them. A margin of rows, so that repeats can be dropped (ignoring case) and 5 still remain.
        recentPhrases = !isLoggedIn ? [] : (await Db.TablePhrases
                .AsNoTracking()
                .OrderByDescending(p => p.CreatedUtc)
                .Select(p => p.Phrase)
                .Take(50)
                .ToListAsync())
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .Take(RecentPhraseCount)
            .ToList();

        autoReset = isAdmin && await Db.BoardSettings.AsNoTracking().AnyAsync(s => s.AutoResetEnabled);
        feedbackCount = isAdmin ? Feedback.Count() : 0;
    }

    /// <summary>Runs a write, shows its error (if any) and reloads. Ignores clicks while another write is running.</summary>
    private async Task WriteAsync(Func<Task<string?>> write, string saveFailedMessage)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        errorMessage = null;
        try
        {
            errorMessage = await write();
        }
        catch (DbUpdateException)
        {
            errorMessage = saveFailedMessage;
        }
        finally
        {
            Db.ChangeTracker.Clear();
            await LoadAsync();
            busy = false;
        }
    }

    // ---------- slots ----------

    private Task TakeSlotAsync(int tableId, int slot) => WriteAsync(async () =>
    {
        if (userId is null || displayName is null)
        {
            return "Zaloguj się, aby zająć miejsce.";
        }

        var table = await Db.PlayTables.Include(t => t.Participants).FirstOrDefaultAsync(t => t.Id == tableId);
        if (table is null)
        {
            return "Ten stół już nie istnieje.";
        }

        if (!table.TryTakeSlot(slot, displayName, userId, out var error))
        {
            return error;
        }

        // Saved together with the seat, so the log never records a join that didn't happen.
        Db.UserActionLogs.Add(UserActionLog.JoinedTable(table, slot, userId, displayName));
        await Db.SaveChangesAsync();
        return null;
    }, "Nie udało się zająć miejsca (być może ktoś był szybszy). Spróbuj ponownie.");

    private Task FreeSlotAsync(int tableId, int slot) => WriteAsync(async () =>
    {
        if (userId is null)
        {
            return "Zaloguj się, aby zwolnić miejsce.";
        }

        // Only the person in the slot, the table's owner or an admin may free it.
        var entry = await Db.TableSlots.FirstOrDefaultAsync(s =>
            s.PlayTableId == tableId && s.SlotNumber == slot
            && (isAdmin || s.UserId == userId || s.PlayTable.OwnerUserId == userId));

        if (entry is null)
        {
            return "Nie możesz zwolnić tego miejsca.";
        }

        Db.TableSlots.Remove(entry);
        await Db.SaveChangesAsync();
        return null;
    }, "Nie udało się zwolnić miejsca. Spróbuj ponownie.");

    // ---------- add-player popup ----------

    private async Task OpenAddPlayerAsync(PlayTable table, int slot, MouseEventArgs e)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var users = await Db.Users
                .AsNoTracking()
                .OrderBy(u => u.UserName)
                .Select(u => new { u.Id, u.UserName })
                .ToListAsync();

            playerOptions = users
                .Where(u => slot == PlayTable.OwnerSlot
                    // Anyone but the person already there; a player seated elsewhere gets moved over.
                    ? table.Participants.All(p => p.SlotNumber != PlayTable.OwnerSlot || p.UserId != u.Id)
                    : !table.IsOwner(u.Id) && table.Participants.All(p => p.UserId != u.Id))
                .Select(u => new PlayerOption(u.Id, ShortName(u.UserName)))
                .ToList();
        }
        finally
        {
            busy = false;
        }

        freeTextName = string.Empty;
        addTarget = new AddPlayerTarget(table.Id, slot, (int)e.ClientX, (int)e.ClientY);
        focusFreeText = true;
    }

    private void CloseAddPlayer() => addTarget = null;

    private void OnAddPlayerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseAddPlayer();
        }
    }

    private async Task AddPlayerAsync(string name, string? playerUserId)
    {
        if (addTarget is not { } target || string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        await WriteAsync(() => EditAsOwnerAsync(target.TableId, table =>
        {
            string? error;
            if (target.Slot != PlayTable.OwnerSlot)
            {
                return table.TryAddPlayer(target.Slot, name, playerUserId, out error) ? null : error;
            }

            if (!isAdmin || playerUserId is null)
            {
                return "Tylko administrator może wskazać właściciela stołu.";
            }

            return table.TryAssignOwner(playerUserId, name, out error) ? null : error;
        }), "Nie udało się zapisać zmiany.");

        CloseAddPlayer();
    }

    // ---------- owner's edits ----------

    private const string NotOwnerError = "Tylko właściciel stołu lub administrator może go edytować.";

    /// <summary>The table, tracked, if the current user owns it or is an admin; otherwise null.</summary>
    private async Task<PlayTable?> LoadManagedTableAsync(int tableId) =>
        // The owner check is part of the query, so hidden controls are not the only protection.
        userId is null
            ? null
            : await Db.PlayTables.Include(t => t.Participants)
                .FirstOrDefaultAsync(t => t.Id == tableId && (isAdmin || t.OwnerUserId == userId));

    private async Task<string?> EditAsOwnerAsync(int tableId, Func<PlayTable, string?> edit)
    {
        var table = await LoadManagedTableAsync(tableId);
        if (table is null)
        {
            return NotOwnerError;
        }

        var error = edit(table);
        if (error is null)
        {
            await Db.SaveChangesAsync();
        }
        return error;
    }

    // ---------- renaming a table ----------

    private bool Renaming => renameTableId is not null;

    private PlayTable? RenamedTable => tables?.FirstOrDefault(t => t.Id == renameTableId);

    private bool RenameReady => !bggBusy && candidates is null && !string.IsNullOrWhiteSpace(renameName);

    // A BGG game brings its own seat count; otherwise the table keeps its own.
    private int RenamedMaxPlayers =>
        selectedGame is { BggId: not null, MaxPlayers: > 0 } game ? game.MaxPlayers : RenamedTable?.MaxPlayers ?? 0;

    private void OpenRename(PlayTable table)
    {
        // The lookup is shared, so an unfinished new table is dropped.
        ResetDraft();
        renameTableId = table.Id;
        renameName = table.DisplayTitle;
        focusRenameInput = true;
    }

    private void CloseRename()
    {
        renameTableId = null;
        renameName = string.Empty;
        formError = null;
        ResetLookup();
    }

    private void OnRenameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseRename();
        }
    }

    private async Task RenameTableAsync()
    {
        formError = null;

        if (renameTableId is not { } tableId || RenamedTable is not { } current)
        {
            CloseRename();
            return;
        }

        if (bggBusy)
        {
            formError = "Poczekaj na wynik wyszukiwania na BoardGameGeek.";
            return;
        }

        if (candidates is not null)
        {
            formError = "Wybierz grę z listy albo kliknij „Żadna z tych”.";
            return;
        }

        var name = renameName.Trim();
        if (name.Length == 0)
        {
            formError = "Podaj nazwę gry.";
            return;
        }

        var maxPlayers = RenamedMaxPlayers;
        if (TooManySpotsError(maxPlayers) is { } tooManySpots)
        {
            formError = tooManySpots;
            return;
        }

        var oldTitle = current.DisplayTitle;
        var renamed = false;

        await WriteAsync(async () =>
        {
            var table = await LoadManagedTableAsync(tableId);
            if (table is null)
            {
                return NotOwnerError;
            }

            var known = selectedGame ?? FindInCatalog(name);
            var game = known is null ? null : await Db.Games.FirstOrDefaultAsync(g => g.Id == known.Id);
            if (game is null)
            {
                game = new Game { Name = name, Kind = table.Kind, MaxPlayers = maxPlayers, BggUrl = DefaultBggUrl };
                Db.Games.Add(game);
            }

            if (!table.TryChangeGame(game, name, maxPlayers, out var error))
            {
                return error;
            }

            await Db.SaveChangesAsync();
            renamed = true;
            return null;
        }, "Nie udało się zmienić gry stołu.");

        if (renamed)
        {
            statusMessage = $"Zmieniono grę stołu: {oldTitle} → {name}.";
            CloseRename();
        }
        else if (errorMessage is not null)
        {
            // Shown in the popup, next to the name it's about.
            formError = errorMessage;
            errorMessage = null;
        }
    }

    private async Task DeleteTableAsync(int tableId)
    {
        await WriteAsync(async () =>
        {
            // The permission check is part of the query; the game stays in the catalog.
            var table = userId is null
                ? null
                : await Db.PlayTables.Include(t => t.Game).Include(t => t.Participants)
                    .FirstOrDefaultAsync(t => t.Id == tableId && (isAdmin || t.OwnerUserId == userId));

            if (table is null)
            {
                return "Tylko właściciel stołu lub administrator może go usunąć.";
            }

            Db.PlayTables.Remove(table);
            await Db.SaveChangesAsync();
            statusMessage = $"Usunięto stół: {table.DisplayTitle}.";
            return null;
        }, "Nie udało się usunąć stołu.");
    }

    private async Task SetTakenSlotsAsync(int tableId, string? rawValue)
    {
        await WriteAsync(() => EditAsOwnerAsync(tableId, table =>
        {
            if (!int.TryParse(rawValue, out var count))
            {
                return "Podaj liczbę zajętych miejsc.";
            }
            return table.TrySetTakenSlots(count, out var error) ? null : error;
        }), "Nie udało się zapisać liczby zajętych miejsc.");

        if (errorMessage is not null)
        {
            takenInputVersion++;
        }
    }

    private Task SetKindAsync(int tableId, string? rawValue) =>
        WriteAsync(() => EditAsOwnerAsync(tableId, table =>
        {
            if (!Enum.TryParse<TableKind>(rawValue, out var kind) || !Enum.IsDefined(kind))
            {
                return "Nieznany rodzaj stołu.";
            }
            table.Kind = kind;
            return null;
        }), "Nie udało się zapisać rodzaju stołu.");

    private Task SetHourAsync(int tableId, TimeOnly? hour) =>
        WriteAsync(() => EditAsOwnerAsync(tableId, table =>
        {
            table.SetStartTime(hour);
            return null;
        }), "Nie udało się zapisać godziny.");

    // ---------- admin toolbox ----------

    private async Task ClearTablesAsync()
    {
        int? removed = null;
        await WriteAsync(async () =>
        {
            if (!isAdmin)
            {
                return "Tylko administrator może wyczyścić listę stołów.";
            }

            try
            {
                removed = await Resetter.ClearTablesAsync();
            }
            // Bulk deletes bypass SaveChanges, so their failures aren't DbUpdateExceptions.
            catch (System.Data.Common.DbException)
            {
                return "Nie udało się wyczyścić listy stołów.";
            }
            return null;
        }, "Nie udało się wyczyścić listy stołów.");

        if (removed is { } count)
        {
            statusMessage = $"Usunięto wszystkie stoły ({count}).";
        }
    }

    private Task SetAutoResetAsync(bool enabled) => WriteAsync(async () =>
    {
        if (!isAdmin)
        {
            return "Tylko administrator może zmienić to ustawienie.";
        }

        var settings = await Resetter.GetSettingsAsync();
        settings.SetAutoReset(enabled, DateTime.UtcNow);
        await Db.SaveChangesAsync();
        return null;
    }, "Nie udało się zapisać ustawienia automatycznego czyszczenia.");

    /// <summary>Downloads every user comment as a zip, then deletes those files from the server.</summary>
    private async Task DownloadFeedbackAsync()
    {
        if (busy)
        {
            return;
        }

        errorMessage = null;
        statusMessage = null;
        busy = true;
        try
        {
            var packed = Feedback.Pack(DateTime.Now);
            if (packed is null)
            {
                statusMessage = "Brak uwag do pobrania.";
                return;
            }

            using var stream = new MemoryStream(packed.Zip);
            using var streamRef = new DotNetStreamReference(stream);
            // Returns once the browser has the whole zip, so a failed download deletes nothing.
            await JS.InvokeVoidAsync("downloadFileFromStream", packed.FileName, streamRef);

            try
            {
                Feedback.Delete(packed.Files);
                statusMessage = $"Pobrano i usunięto uwagi ({packed.Files.Count}).";
            }
            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
            {
                errorMessage = "Uwagi pobrano, ale nie udało się usunąć ich z serwera.";
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or JSException)
        {
            errorMessage = "Nie udało się pobrać uwag.";
        }
        finally
        {
            feedbackCount = Feedback.Count();
            busy = false;
        }
    }

    /// <summary>Reads the server's disk usage for the admin toolbox.</summary>
    private async Task ShowDiskUsageAsync()
    {
        if (busy)
        {
            return;
        }

        errorMessage = null;
        if (!isAdmin)
        {
            errorMessage = "Tylko administrator może sprawdzić miejsce na dysku.";
            return;
        }

        busy = true;
        try
        {
            // Walks the feedback folder, so it runs off the circuit's thread.
            diskUsage = await Task.Run(Disk.Read);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException)
        {
            errorMessage = "Nie udało się odczytać zajętości dysku.";
        }
        finally
        {
            busy = false;
        }
    }

    // ---------- new table form ----------

    // The name is only bound once the field loses focus, so the lookup has started by the time this is checked.
    private bool DraftDetailsVisible => !bggBusy && candidates is null && !string.IsNullOrWhiteSpace(newTable.GameName);

    // Only for a game BGG doesn't have, and which has no cover yet.
    private bool CanUploadDraftCover => selectedGame is null || selectedGame is { BggId: null, HasCover: false };

    private void ResetDraft()
    {
        // Games not found on BGG still use a random count during early development.
        // Drawn here rather than on save, because "Zajęte" has to fit within it.
        drawnMaxPlayers = Random.Shared.Next(1, 7);
        newTable = new NewTableModel { MaxPlayers = drawnMaxPlayers };
        newCover = null;
        newCoverType = null;
        formError = null;
        ResetLookup();
    }

    private CatalogEntry? FindInCatalog(string? name) =>
        catalog.FirstOrDefault(g => string.Equals(g.Name, name?.Trim(), StringComparison.OrdinalIgnoreCase));

    // ---------- game lookup: the catalog's titles first, then BGG ----------

    // The lookup serves either the new table form or the rename popup.
    private string LookupName => Renaming ? renameName : newTable.GameName;

    private TableKind LookupKind => Renaming ? RenamedTable?.Kind ?? TableKind.Small : newTable.Kind;

    // The lookup's progress, choices and errors; shown under the new table form or in the rename popup.
    private RenderFragment LookupMessages => @<text>
        @if (formError is not null)
        {
            <div class="alert alert-danger py-2 mb-2" role="alert">@formError</div>
        }

        @if (bggBusy)
        {
            <div role="status">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                Wczytuję dane z BoardGameGeek...
            </div>
        }

        @if (bggNote is not null)
        {
            <div class="form-text mt-0" role="status">@bggNote</div>
        }

        @if (candidates is not null)
        {
            <div class="form-text mt-0 mb-1">@candidatesTitle</div>
            <div class="candidate-list">
                @foreach (var candidate in candidates)
                {
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-light candidate-name" disabled="@(bggBusy || busy)" @onclick="() => PickCandidateAsync(candidate)">
                            @candidate.Name@(candidate.Year is { } year ? $" ({year})" : "")
                        </button>
                        <a class="btn btn-outline-light candidate-link" href="https://boardgamegeek.com/boardgame/@candidate.BggId" target="_blank" rel="noopener noreferrer"
                           title="Zobacz na BoardGameGeek" aria-label="Zobacz na BoardGameGeek: @candidate.Name">↗</a>
                    </div>
                }
                <button type="button" class="btn btn-outline-light btn-sm" @onclick="RejectCandidatesAsync">Żadna z tych</button>
            </div>
        }

        @if (!bggBusy && candidates is null && selectedGame is { BggId: not null } found)
        {
            <div class="form-text mt-0" role="status">Znaleziono na BoardGameGeek: @CatalogLabel(found)</div>
        }
    </text>;

    private void ResetLookup()
    {
        lookupVersion++;
        bggBusy = false;
        bggNote = null;
        candidates = null;
        candidatesTitle = null;
        selectedGame = null;
        selectedCoverSrc = null;
    }

    // Same as typing the name and leaving the field.
    private async Task UseRecentPhraseAsync(string phrase)
    {
        newTable.GameName = phrase;
        await OnGameNameChangedAsync();
    }

    private async Task OnGameNameChangedAsync()
    {
        ResetLookup();
        formError = null;
        if (!Renaming)
        {
            newCover = null;
            newCoverType = null;
            newTable.MaxPlayers = drawnMaxPlayers;
        }

        var name = LookupName.Trim();
        if (name.Length == 0)
        {
            return;
        }

        // Hand-added games aren't considered yet: they're only used when BGG has nothing.
        var matches = catalog
            .Where(g => g.BggId is not null
                && (string.Equals(g.Name, name, StringComparison.OrdinalIgnoreCase)
                    || g.AlternateNames.Contains(name, StringComparer.OrdinalIgnoreCase)))
            .ToList();

        switch (matches)
        {
            // Its cover couldn't be downloaded last time: try again.
            case [{ BggId: { } bggId, HasCover: false }]:
                await RunBggLookupAsync(version => ImportFromBggAsync(bggId, version));
                break;
            case [var match]:
                await SelectCatalogGameAsync(match);
                break;
            case []:
                await RunBggLookupAsync(version => SearchBggAsync(name, version, pickSingleExactMatch: true));
                break;
            default:
                ShowCandidates("Ta nazwa pasuje do kilku gier w katalogu. Wybierz właściwą:",
                    matches.Select(g => new GameCandidate(g.Name, g.Year, g.BggId ?? 0)));
                break;
        }
    }

    /// <summary>The fallback for when BGG has nothing: an existing hand-added game of this name, if there is one.</summary>
    private async Task UseHandAddedGameAsync()
    {
        if (FindInCatalog(LookupName) is { BggId: null } handAdded)
        {
            await SelectCatalogGameAsync(handAdded);
        }
    }

    /// <summary>Lets the user reach BGG even when the catalog already has a match, e.g. to choose another edition.</summary>
    private async Task SearchBggManuallyAsync()
    {
        var name = LookupName.Trim();

        // Ignored while busy: leaving the name field to click this button has already started a lookup.
        if (bggBusy || name.Length == 0)
        {
            return;
        }

        await RunBggLookupAsync(version => SearchBggAsync(name, version, pickSingleExactMatch: false));
    }

    private async Task RunBggLookupAsync(Func<int, Task> lookup)
    {
        if (!Bgg.IsConfigured)
        {
            await UseHandAddedGameAsync();
            return;
        }

        var version = ++lookupVersion;
        bggBusy = true;
        bggNote = null;
        try
        {
            await lookup(version);
        }
        catch (BggUnavailableException)
        {
            if (version == lookupVersion)
            {
                bggNote = "Nie udało się połączyć z BoardGameGeek. Spróbuj ponownie przyciskiem BGG albo dodaj grę ręcznie.";
                await UseHandAddedGameAsync();
            }
        }
        finally
        {
            if (version == lookupVersion)
            {
                bggBusy = false;
            }
        }
    }

    private async Task SearchBggAsync(string name, int version, bool pickSingleExactMatch)
    {
        var results = await Bgg.SearchAsync(name);
        if (version != lookupVersion)
        {
            return;
        }

        var exactMatches = results.Where(r => string.Equals(r.Name, name, StringComparison.OrdinalIgnoreCase)).ToList();

        if (results.Count == 0)
        {
            bggNote = "Nie znaleziono tej gry na BoardGameGeek. Możesz dodać ją ręcznie.";
            await UseHandAddedGameAsync();
        }
        else if (pickSingleExactMatch && (exactMatches.Count == 1 || results.Count == 1))
        {
            await ImportFromBggAsync(exactMatches.Count == 1 ? exactMatches[0].Id : results[0].Id, version);
        }
        else
        {
            var title = results.Count > MaxListedCandidates
                ? $"Znaleziono {results.Count} gier na BoardGameGeek, poniżej pierwsze {MaxListedCandidates}. Wybierz właściwą lub zawęź nazwę:"
                : "Wybierz właściwą grę lub wydanie z BoardGameGeek:";

            // Exact title matches first, newest editions first within each group.
            ShowCandidates(title, results
                .OrderByDescending(r => string.Equals(r.Name, name, StringComparison.OrdinalIgnoreCase))
                .ThenByDescending(r => r.Year)
                .Take(MaxListedCandidates)
                .Select(r => new GameCandidate(r.Name, r.Year, r.Id)));
        }
    }

    private void ShowCandidates(string title, IEnumerable<GameCandidate> list)
    {
        candidatesTitle = title;
        candidates = list.ToList();
    }

    private async Task RejectCandidatesAsync()
    {
        candidates = null;
        candidatesTitle = null;

        // A game picked earlier stays when the BGG button's list is dismissed.
        if (selectedGame is null)
        {
            bggNote = "Gra zostanie dodana ręcznie.";
            await UseHandAddedGameAsync();
        }
    }

    private async Task PickCandidateAsync(GameCandidate candidate)
    {
        if (bggBusy || busy)
        {
            return;
        }

        await RunBggLookupAsync(version => ImportFromBggAsync(candidate.BggId, version));
    }

    /// <summary>Adds a BGG game to the catalog, so that it (and its cover) only has to be downloaded once.</summary>
    private async Task ImportFromBggAsync(int bggId, int version)
    {
        var cached = catalog.FirstOrDefault(g => g.BggId == bggId);
        if (cached is { HasCover: true })
        {
            await SelectCatalogGameAsync(cached);
            return;
        }

        var details = await Bgg.GetGameAsync(bggId);
        if (details is null)
        {
            if (version == lookupVersion)
            {
                bggNote = "BoardGameGeek nie zwrócił danych tej gry.";
            }
            return;
        }

        var cover = details.ThumbnailUrl is { } url ? await Bgg.DownloadCoverAsync(url) : null;
        if (version != lookupVersion)
        {
            return;
        }

        var kind = LookupKind;
        await WriteAsync(async () =>
        {
            await SaveBggGameAsync(details, cover, kind);
            return null;
        }, "Nie udało się zapisać gry w katalogu.");

        if (version != lookupVersion)
        {
            return;
        }

        if (catalog.FirstOrDefault(g => g.BggId == bggId) is { } imported)
        {
            await SelectCatalogGameAsync(imported);
        }
        else if (errorMessage is null)
        {
            bggNote = "Nie udało się zapisać gry w katalogu. Spróbuj ponownie.";
        }
    }

    private async Task SaveBggGameAsync(BggGameDetails details, BggCover? cover, TableKind kind)
    {
        var existing = catalog.FirstOrDefault(g => g.BggId == details.Id);

        // BGG takes priority: a game added by hand under one of the BGG titles becomes that BGG game.
        var handAdded = existing is not null
            ? null
            : catalog.FirstOrDefault(g => g.BggId is null
                && (string.Equals(g.Name, details.Name, StringComparison.OrdinalIgnoreCase)
                    || details.AlternateNames.Contains(g.Name, StringComparer.OrdinalIgnoreCase)));

        var game = (existing ?? handAdded) is { } entry
            ? await Db.Games.Include(g => g.AlternateNames).FirstOrDefaultAsync(g => g.Id == entry.Id)
            : null;

        if (game is null)
        {
            game = new Game { Name = UniqueCatalogName(details, ignoredGameId: null), Kind = kind };
            Db.Games.Add(game);
        }
        else if (handAdded is not null)
        {
            game.Name = UniqueCatalogName(details, ignoredGameId: handAdded.Id);
        }

        game.ApplyBggData(details, cover);
        await Db.SaveChangesAsync();
    }

    // Catalog names are unique, but BGG lists separate editions under the same name.
    private string UniqueCatalogName(BggGameDetails details, int? ignoredGameId)
    {
        string[] options = details.Year is { } year
            ? [details.Name, $"{details.Name} ({year})"]
            : [details.Name];

        return options.FirstOrDefault(name => FindInCatalog(name) is not { } taken || taken.Id == ignoredGameId)
            ?? $"{details.Name} [BGG {details.Id}]";
    }

    private static string CatalogLabel(CatalogEntry game) =>
        game.Year is { } year && !game.Name.Contains($"({year})") ? $"{game.Name} ({year})" : game.Name;

    private async Task SelectCatalogGameAsync(CatalogEntry game)
    {
        // The name field keeps what the user typed: that's the title the table will show.
        // A renamed table keeps its own type.
        if (!Renaming)
        {
            newTable.Kind = game.Kind;
            newTable.MaxPlayers = game is { BggId: not null, MaxPlayers: > 0 } ? game.MaxPlayers : drawnMaxPlayers;
        }

        selectedGame = game;
        selectedCoverSrc = null;
        candidates = null;
        candidatesTitle = null;
        formError = TooManySpotsError(Renaming ? RenamedMaxPlayers : newTable.MaxPlayers);

        // Only a preview for the new table form, so it's skipped rather than risking two queries on one DbContext.
        if (!Renaming && game.HasCover && !busy)
        {
            busy = true;
            try
            {
                var cover = await Db.Games.AsNoTracking()
                    .Where(g => g.Id == game.Id)
                    .Select(g => new { g.Cover, g.CoverContentType })
                    .FirstOrDefaultAsync();
                selectedCoverSrc = CoverSrc(cover?.Cover, cover?.CoverContentType);
            }
            finally
            {
                busy = false;
            }
        }
    }

    private string? TooManySpotsError(int maxPlayers) =>
        maxPlayers > Settings.Value.MaximumSpotsAllowed
            ? $"Nie można tworzyć stołów dla gier z więcej niż {Settings.Value.MaximumSpotsAllowed} miejscami."
            : null;

    private async Task OnCoverSelected(InputFileChangeEventArgs e)
    {
        formError = null;
        newCover = null;
        newCoverType = null;

        if (!CanUploadDraftCover)
        {
            return;
        }

        if (!Game.AllowedCoverTypes.Contains(e.File.ContentType))
        {
            formError = "Okładka musi być obrazem PNG, JPEG, WebP lub GIF.";
            return;
        }

        if (e.File.Size > Game.MaxCoverBytes)
        {
            formError = "Okładka może mieć maksymalnie 2 MB.";
            return;
        }

        await using var stream = e.File.OpenReadStream(Game.MaxCoverBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);

        newCover = buffer.ToArray();
        newCoverType = e.File.ContentType;
    }

    private async Task CreateTableAsync()
    {
        formError = null;

        if (userId is null || displayName is null)
        {
            formError = "Zaloguj się, aby utworzyć stół.";
            return;
        }

        // Clicking the button right after editing the name starts a new lookup first.
        if (bggBusy)
        {
            formError = "Poczekaj na wynik wyszukiwania na BoardGameGeek.";
            return;
        }

        if (candidates is not null)
        {
            formError = "Wybierz grę z listy albo kliknij „Żadna z tych”.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newTable.GameName))
        {
            formError = "Podaj nazwę gry.";
            return;
        }

        if (newTable.GameName.Trim().Length > 200)
        {
            formError = "Nazwa może mieć maksymalnie 200 znaków.";
            return;
        }

        if (TooManySpotsError(newTable.MaxPlayers) is { } tooManySpots)
        {
            formError = tooManySpots;
            return;
        }

        if (newTable.TakenSlots < 0)
        {
            formError = "Liczba zajętych miejsc nie może być ujemna.";
            return;
        }

        if (newTable.TakenSlots >= newTable.MaxPlayers)
        {
            formError = "Przy stole musi zostać co najmniej jedno miejsce dla Ciebie.";
            return;
        }

        var name = newTable.GameName.Trim();
        var created = false;

        await WriteAsync(async () =>
        {
            var known = selectedGame ?? FindInCatalog(name);
            var game = known is null ? null : await Db.Games.FirstOrDefaultAsync(g => g.Id == known.Id);

            if (game is null)
            {
                game = new Game
                {
                    Name = name,
                    Kind = newTable.Kind,
                    MaxPlayers = newTable.MaxPlayers,
                    BggUrl = DefaultBggUrl
                };
                Db.Games.Add(game);
            }

            // Checked here too, not just by hiding the button.
            if (newCover is not null && game.CanUploadCover)
            {
                game.Cover = newCover;
                game.CoverContentType = newCoverType;
            }

            // The owner automatically gets the first slot.
            if (!PlayTable.TryCreate(game, name, newTable.Kind, newTable.MaxPlayers, newTable.TakenSlots, newTable.Hour,
                    userId, displayName, out var table, out var createError))
            {
                return createError;
            }

            Db.PlayTables.Add(table);
            // Saved together with the table; feeds the "Ostatnio" names under the board's game field.
            Db.TablePhrases.Add(TablePhrase.For(table, userId));
            await Db.SaveChangesAsync();
            created = true;
            return null;
        }, "Nie udało się zapisać stołu w bazie danych.");

        if (created)
        {
            statusMessage = $"Utworzono stół: {name}.";
            ResetDraft();
        }
    }

    // ---------- presentation ----------

    private string FreeSlotHint(PlayTable table, int slot, bool hasSeat) =>
        !isLoggedIn ? "Zaloguj się, aby zająć miejsce"
        : hasSeat ? "Masz już miejsce przy tym stole"
        : table.IsOwner(userId) ? (slot == PlayTable.OwnerSlot ? "Zajmij to miejsce" : "Jako właściciel stołu możesz zająć tylko pierwsze miejsce")
        : slot == PlayTable.OwnerSlot && table.OwnerUserId is not null ? "Zajmij to miejsce – zostaniesz właścicielem stołu"
        : "Zajmij to miejsce";

