@*
    Two-click delete: ❌ arms it, the whole button turns green with a white ✓, and a second click deletes.
    The page sizes the button through ::deep .confirm-delete (hover rules with :not(.armed)).
*@
<ConfirmButton Class="@($"confirm-delete {Class}")" OnConfirm="OnConfirm" Disabled="@Disabled"
               Title="@Title" ArmedTitle="@ArmedTitle" DisabledTitle="@DisabledTitle"
               AriaLabel="@($"{Title}: {ItemName}")" ArmedAriaLabel="@($"{ArmedTitle}: {ItemName}")">
    <ChildContent>❌</ChildContent>
    <ArmedContent><span class="confirm-check" aria-hidden="true">✓</span></ArmedContent>
</ConfirmButton>

@code {
    /// <summary>Called on the confirming (second) click.</summary>
    [Parameter, EditorRequired] public EventCallback OnConfirm { get; set; }

    /// <summary>Name of the thing being deleted, for the screen-reader label.</summary>
    [Parameter, EditorRequired] public string ItemName { get; set; } = string.Empty;

    [Parameter] public string Title { get; set; } = "Usuń";
    [Parameter] public string ArmedTitle { get; set; } = "Kliknij ponownie, aby usunąć";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? DisabledTitle { get; set; }
    [Parameter] public string? Class { get; set; }
}
