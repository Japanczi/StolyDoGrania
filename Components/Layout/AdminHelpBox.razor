@* Reminder of what an admin can do. Informational only: permissions are enforced where the actions run. *@
@if (open)
{
    <section class="admin-help" aria-label="Uprawnienia administratora">
        <div class="admin-help-head">
            <strong>Uprawnienia administratora</strong>
            <button type="button" class="btn-close" aria-label="Zwiń" @onclick="() => open = false"></button>
        </div>

        <p class="admin-help-intro">Na każdym stole:</p>

        <ul>
            <li><strong>Wiersz stołu:</strong> edycja ustawień</li>
            <li><strong>Lewy przycisk na graczu:</strong> usunięcie</li>
            <li><strong>Prawy przycisk na „Wolne” lub „Zajęte”:</strong> dodanie gracza</li>
            <li><strong>Prawy przycisk na 1. miejscu:</strong> nowy właściciel</li>
            <li><strong>❌:</strong> usunięcie stołu</li>
        </ul>

        <a class="admin-help-link" href="admin/users">Użytkownicy</a>
    </section>
}
else
{
    <button type="button" class="btn btn-secondary btn-sm admin-help-toggle" @onclick="() => open = true">
        🛡️ Uprawnienia admina
    </button>
}

@code {
    private bool open;
}
