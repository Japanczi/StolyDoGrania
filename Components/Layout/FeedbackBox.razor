@using System.Security.Claims
@inject IWebHostEnvironment Env
@inject NavigationManager Nav

@* Logged-in users only, in every environment; comments are saved server-side. *@
@if (signedIn)
{
@if (open)
{
    <section id="feedback-card" class="feedback-card" aria-label="Uwagi do strony" @onkeydown="OnKeyDown">
        <div class="feedback-head">
            <strong>Masz uwagę?</strong>
            <button type="button" class="btn-close btn-close-sm" aria-label="Zamknij" @onclick="() => open = false"></button>
        </div>
        <p class="feedback-hint">Napisz, co poprawić na tej stronie.</p>

        <textarea class="form-control form-control-sm" rows="4" maxlength="@MaxLength" aria-label="Treść uwagi"
                  placeholder="Twoja uwaga…"
                  @bind="comment" @bind:event="oninput"></textarea>

        <div class="feedback-foot">
            <span class="feedback-count">@comment.Length/@MaxLength</span>
            <button type="button" class="btn btn-success btn-sm"
                    disabled="@(string.IsNullOrWhiteSpace(comment) || saving)" @onclick="SaveAsync">
                Wyślij
            </button>
        </div>

        @if (status is not null)
        {
            <div class="feedback-status @(failed ? "text-danger" : "text-success")" role="status">@status</div>
        }
    </section>
}

<button type="button" class="feedback-bubble @(open ? "is-open" : null)"
        aria-label="@(open ? "Zamknij uwagi" : "Zgłoś uwagę")" title="@(open ? "Zamknij" : "Zgłoś uwagę")"
        aria-expanded="@(open ? "true" : "false")" aria-controls="feedback-card"
        @onclick="() => open = !open">
    @(open ? "✕" : "💬")
</button>
}

@code {
    private const int MaxLength = 4000;
    private const string Anonymous = "(niezalogowany)";

    // Resolved here (not passed in) so the box works from any layout, including static Identity pages.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool signedIn;
    private bool open;
    private bool saving;
    private bool failed;
    private string comment = string.Empty;
    private string? status;

    protected override async Task OnParametersSetAsync()
    {
        signedIn = AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated == true;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            open = false;
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(comment) || saving)
        {
            return;
        }

        var user = AuthState is null ? null : (await AuthState).User;
        // Server-side check too: anonymous visitors never get to write a file, even with a stale circuit.
        if (user?.Identity?.IsAuthenticated != true)
        {
            signedIn = open = false;
            return;
        }

        saving = true;
        var now = DateTime.Now;
        // Full Identity UserName (often an e-mail) and id: written only to the server-side file, never shown.
        var fullUserName = user.Identity.Name;
        var userId = user?.FindFirstValue(ClaimTypes.NameIdentifier);
        var shortName = UserNames.Short(fullUserName);
        // Read at save time, so it is the subpage the user is on now, not the one the box was first rendered on.
        var page = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        // One file per comment, so saves never have to share or lock a file.
        var fileName = $"{now:yyyyMMdd-HHmmss}-{Guid.NewGuid().ToString("N")[..6]}.md";
        var content = $"""
            ---
            date: {now:yyyy-MM-dd HH:mm:ss}
            page: {page}
            user: {(shortName.Length > 0 ? shortName : Anonymous)}
            userName: {(string.IsNullOrEmpty(fullUserName) ? Anonymous : fullUserName)}
            userId: {(string.IsNullOrEmpty(userId) ? Anonymous : userId)}
            ---

            {comment.Trim()}

            """;

        try
        {
            var folder = Path.Combine(Env.ContentRootPath, "Claude_Resources", "Feedback");
            Directory.CreateDirectory(folder);
            await File.WriteAllTextAsync(Path.Combine(folder, fileName), content);

            comment = string.Empty;
            failed = false;
            status = $"Dziękujemy! Uwaga zapisana o {now:HH:mm}.";
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            // The typed text stays in the box, so nothing is lost and it can be retried.
            failed = true;
            status = "Nie udało się zapisać uwagi. Spróbuj ponownie.";
        }
        finally
        {
            saving = false;
        }
    }
}
