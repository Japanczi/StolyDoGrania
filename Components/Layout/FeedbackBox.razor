@inject IWebHostEnvironment Env
@inject NavigationManager Nav

@* Debug tool: renders and saves only in the Development environment. *@
@if (Env.IsDevelopment())
{
    @if (open)
    {
        <section class="feedback-box" aria-label="Uwagi do strony">
            <div class="feedback-head">
                <strong>Uwagi (debug)</strong>
                <button type="button" class="btn-close" aria-label="Zwiń" @onclick="() => open = false"></button>
            </div>

            <textarea class="form-control" rows="4" maxlength="@MaxLength" aria-label="Treść uwagi"
                      placeholder="Co poprawić na tej stronie?"
                      @bind="comment" @bind:event="oninput"></textarea>

            <div class="feedback-foot">
                <span class="feedback-status @(failed ? "text-danger" : "text-success")" role="status">@status</span>
                <button type="button" class="btn btn-primary btn-sm"
                        disabled="@(string.IsNullOrWhiteSpace(comment) || saving)" @onclick="SaveAsync">
                    Zapisz uwagę
                </button>
            </div>
        </section>
    }
    else
    {
        <button type="button" class="btn btn-primary btn-sm feedback-toggle" @onclick="() => open = true">
            💬 Uwagi
        </button>
    }
}

@code {
    private const int MaxLength = 4000;

    // Resolved here (not passed in) so the box works from any layout, including static Identity pages.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool open;
    private bool saving;
    private bool failed;
    private string comment = string.Empty;
    private string? status;

    private async Task SaveAsync()
    {
        if (!Env.IsDevelopment() || string.IsNullOrWhiteSpace(comment) || saving)
        {
            return;
        }

        saving = true;
        var now = DateTime.Now;
        var userName = await GetShortUserNameAsync();
        // Read at save time, so it is the subpage the user is on now, not the one the box was first rendered on.
        var page = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        // One file per comment, so saves never have to share or lock a file.
        var fileName = $"{now:yyyyMMdd-HHmmss}-{Guid.NewGuid().ToString("N")[..6]}.md";
        var content = $"""
            ---
            date: {now:yyyy-MM-dd HH:mm:ss}
            page: {page}
            user: {userName ?? "(niezalogowany)"}
            ---

            {comment.Trim()}

            """;

        try
        {
            var folder = Path.Combine(Env.ContentRootPath, "Claude_Resources", "Feedback");
            Directory.CreateDirectory(folder);
            await File.WriteAllTextAsync(Path.Combine(folder, fileName), content);

            comment = string.Empty;
            failed = false;
            status = $"Zapisano o {now:HH:mm:ss} (strona {page}).";
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            // The typed text stays in the box, so nothing is lost and it can be retried.
            failed = true;
            status = "Nie udało się zapisać uwagi.";
        }
        finally
        {
            saving = false;
        }
    }

    /// <summary>Part of the user name before '@' (a full e-mail is never stored or shown); null when anonymous.</summary>
    private async Task<string?> GetShortUserNameAsync()
    {
        if (AuthState is null)
        {
            return null;
        }

        var name = UserNames.Short((await AuthState).User.Identity?.Name);
        return name.Length > 0 ? name : null;
    }
}
