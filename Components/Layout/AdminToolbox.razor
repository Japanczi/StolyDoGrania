@* Admin tools for the whole list of tables. UI only: the page's handlers run the actions and check permissions. *@
@using Planszowkarz.Components.Pages
<div class="admin-toolbox">
    @if (open)
    {
        <section class="toolbox-panel" aria-label="Narzędzia administratora">
            <div class="toolbox-item">
                @* Two clicks: the first arms it (green, names the count), the second clears the list. *@
                <ConfirmButton Class="toolbox-button" Disabled="@(Busy || TableCount == 0)" OnConfirm="OnClearTables"
                               Title="Usuń wszystkie stoły z listy" DisabledTitle="Lista stołów jest pusta"
                               ArmedTitle="Kliknij ponownie, aby usunąć wszystkie stoły">
                    <ChildContent>Wyczyść listę stołów</ChildContent>
                    <ArmedContent>✓ Kliknij ponownie – usunie @TableCount @TablesWord(TableCount)</ArmedContent>
                </ConfirmButton>

                @* A button rather than a checkbox: its state always comes from the saved setting, even after a failed save. *@
                <button type="button" role="switch" class="toolbox-switch" aria-checked="@(AutoReset ? "true" : "false")"
                        disabled="@Busy" title="@AutoResetHint" aria-label="Auto: @AutoResetHint"
                        @onclick="() => OnAutoResetChanged.InvokeAsync(!AutoReset)">
                    <span class="switch-track" aria-hidden="true"><span class="switch-knob"></span></span>
                    <span class="switch-label">Auto</span>
                </button>
            </div>

            <div class="toolbox-item">
                @* Two clicks too: the comments are deleted from the server once the zip has been downloaded. *@
                <ConfirmButton Class="toolbox-button" Disabled="@(Busy || FeedbackCount == 0)" OnConfirm="OnDownloadFeedback"
                               Title="Pobierz wszystkie uwagi użytkowników jako .zip i usuń je z serwera"
                               DisabledTitle="Brak uwag do pobrania"
                               ArmedTitle="Kliknij ponownie, aby pobrać uwagi i usunąć je z serwera">
                    <ChildContent>Pobierz i usuń uwagi (@FeedbackCount)</ChildContent>
                    <ArmedContent>✓ Kliknij ponownie – pobierze i usunie @FeedbackCount @CommentsWord(FeedbackCount)</ArmedContent>
                </ConfirmButton>
            </div>
        </section>
    }

    <button type="button" class="btn btn-secondary btn-sm toolbox-toggle" aria-expanded="@(open ? "true" : "false")" @onclick="Toggle">
        🧰 Narzędzia admina
    </button>
</div>

@code {
    private const string AutoResetHint = "Włącz, aby lista stołów była czyszczona automatycznie w każdy poniedziałek o północy";

    /// <summary>Number of tables on the list; clearing is disabled when there are none.</summary>
    [Parameter] public int TableCount { get; set; }

    /// <summary>The saved state of the weekly automatic reset.</summary>
    [Parameter] public bool AutoReset { get; set; }

    /// <summary>True while the page is saving something; actions are disabled meanwhile.</summary>
    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback OnClearTables { get; set; }

    /// <summary>Number of user comments saved on the server; downloading is disabled when there are none.</summary>
    [Parameter] public int FeedbackCount { get; set; }

    [Parameter] public EventCallback OnDownloadFeedback { get; set; }

    /// <summary>Called with the requested new state of the automatic reset.</summary>
    [Parameter] public EventCallback<bool> OnAutoResetChanged { get; set; }

    private bool open;

    // Closing the panel removes the button, which also disarms it.
    private void Toggle() => open = !open;

    // Polish plural: 1 stół, 2–4 stoły (except 12–14), otherwise stołów.
    private static string TablesWord(int n) =>
        n == 1 ? "stół"
        : n % 10 is >= 2 and <= 4 && n % 100 is not (>= 12 and <= 14) ? "stoły"
        : "stołów";

    // 1 uwagę, 2–4 uwagi (except 12–14), otherwise uwag.
    private static string CommentsWord(int n) =>
        n == 1 ? "uwagę"
        : n % 10 is >= 2 and <= 4 && n % 100 is not (>= 12 and <= 14) ? "uwagi"
        : "uwag";
}
