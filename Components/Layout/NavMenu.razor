@inject NavigationManager NavigationManager

@* Contents of the slide-in drawer (opened by the Menu button in MainLayout's ribbon). *@
<div class="drawer-head">
    <span class="drawer-title">Menu</span>
    <label for="app-menu-toggle" class="drawer-close" title="Zamknij menu" aria-label="Zamknij menu">✕</label>
</div>

<nav class="drawer-nav flex-column">
    <NavLink class="drawer-link" href="" Match="NavLinkMatch.All">
        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Zapisy na gry
    </NavLink>

    <AuthorizeView Roles="Admin">
        <NavLink class="drawer-link" href="admin/users">
            <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Użytkownicy
        </NavLink>
    </AuthorizeView>

    <hr class="drawer-sep" />

    <AuthorizeView>
        <Authorized>
            <NavLink class="drawer-link" href="Account/Manage">
                <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Profil (@UserNames.Short(context.User.Identity?.Name))
            </NavLink>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
                <button type="submit" class="drawer-link">
                    <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Wyloguj
                </button>
            </form>
        </Authorized>
        <NotAuthorized>
            <NavLink class="drawer-link" href="Account/Register">
                <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Zarejestruj się
            </NavLink>
            <NavLink class="drawer-link" href="Account/Login">
                <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Zaloguj się
            </NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@* Bottom-right corner of the menu. Required by BGG's XML API terms for public-facing uses. *@
<div class="drawer-foot">
    <a class="bgg-credit" href="https://boardgamegeek.com/" target="_blank" rel="noopener noreferrer" title="Dane gier: BoardGameGeek">
        <img src="images/powered-by-bgg.png" alt="Powered by BoardGameGeek" />
    </a>
</div>

@code {
    // Static layout: rendered once per request, so the current URL is known here.
    // The logout endpoint needs a non-empty value; "stoly" is an alias of "/".
    private string ReturnUrl
    {
        get
        {
            var url = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            return string.IsNullOrEmpty(url) ? "stoly" : url;
        }
    }
}
