{
  "name": "planszowkarz",
  "version": "0.1.0",
  "private": true,
  "description": "Planszówkarz – board game table sign-ups (Node rewrite)",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/db/migrate.ts && node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node src/server.ts",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "import-dotnet-db": "node scripts/import-dotnet-db.ts",
    "check": "tsc -p . && tsc -p public/js",
    "test": "node --test --test-timeout=30000 \"test/**/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.12.8",
    "kysely": "^0.29.8",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3": false
  }
}
