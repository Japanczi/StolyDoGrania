# Copy to .env (git-ignored) for local development; `npm run dev` loads it with Node's --env-file-if-exists.
# On the server the same names come from the systemd environment file. Validated at startup by src/config.ts.

# development | production | test
NODE_ENV=development

# Where the server listens. 5180 so it can run beside the .NET app (5223).
HOST=127.0.0.1
PORT=5180

# Address used in links inside e-mails (no trailing slash). Defaults to http://localhost:PORT.
# PUBLIC_URL=https://planszowkarz.toadres.pl

# SQLite database file (created if missing). Relative paths start at node-app/.
DATABASE_PATH=data/planszowkarz.db

# Fastify log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Secret for signing CSRF tokens; required in production (32+ random characters). Generate one with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# APP_SECRET=

# Main admin (Owner), created at startup if missing. All three or none.
# ADMIN_USER_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Outgoing e-mail (SMTP). Without EMAIL_HOST no e-mail is sent and the registration page shows the confirm link.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# starttls | ssl | none
# EMAIL_SECURITY=starttls
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=Planszówkarz

# BoardGameGeek XML API token (Bearer). Without it, game lookups use the catalog and hand-added games only.
# BGG_TOKEN=
